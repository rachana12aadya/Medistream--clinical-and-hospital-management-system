      "title": "PatientRecord",
      "description": "AES-256-GCM encrypted patient chart stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
