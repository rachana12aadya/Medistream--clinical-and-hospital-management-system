        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerUid",
        "mrn",
        "fullName",
        "dateOfBirth",
        "gender",
        "bloodGroup",
        "maskedPhone",
        "maskedEmail",
        "primaryDepartment",
        "assignedDoctorId",
        "assignedDoctorName",
        "encryptionCipher",
        "createdAt",
        "updatedAt"
      ]
    },
