        "primaryDepartment": { "type": "string", "minLength": 2, "maxLength": 80 },
        "assignedDoctorId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedDoctorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "encryptionCipher": { "type": "string", "minLength": 4, "maxLength": 40 },
        "phoneEncrypted": { "type": "string", "maxLength": 1024 },
        "emailEncrypted": { "type": "string", "maxLength": 1024 },
        "allergiesEncrypted": { "type": "string", "maxLength": 2048 },
        "medicalHistoryEncrypted": { "type": "string", "maxLength": 4096 },
        "clinicalNotesEncrypted": { "type": "string", "maxLength": 4096 },
        "prescriptionsEncrypted": { "type": "string", "maxLength": 2048 },
